<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Styles.xaml is loaded after this file. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFD9DCE1" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1B1D21" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF5F6670" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1F6FB5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FFEDEFF2" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#FFE2E5EA" />
</ResourceDictionary>
