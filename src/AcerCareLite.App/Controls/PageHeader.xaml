<UserControl x:Class="AcerCareLite.App.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Page title, optional subtitle, and an optional slot on the right for page-level actions. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Margin="0,4,0,0" FontSize="14"
                       Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Top" Margin="16,0,0,0" />
    </Grid>
</UserControl>
