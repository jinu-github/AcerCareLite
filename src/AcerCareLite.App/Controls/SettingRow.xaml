<UserControl x:Class="AcerCareLite.App.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AcerCareLite.App.Controls"
             x:Name="Root">
    <!-- Title and optional description on the left, the control (switch, choices) on the right. -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,13">
        <ctl:AdaptiveRowPanel Gap="16" StackGap="10" MinPrimaryWidth="170">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="14.5" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description, ElementName=Root}" Margin="0,2,0,0" FontSize="12.5"
                           Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <ContentPresenter Content="{Binding Control, ElementName=Root}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" />
        </ctl:AdaptiveRowPanel>
    </Border>
</UserControl>
