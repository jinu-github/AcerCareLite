<UserControl x:Class="AcerCareLite.App.Controls.PropertyRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Label on the left, value on the right, a thin line above. -->
    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="14" VerticalAlignment="Top"
                       Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" MaxWidth="150" />
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root}" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="16,0,0,0" />
        </Grid>
    </Border>
</UserControl>
