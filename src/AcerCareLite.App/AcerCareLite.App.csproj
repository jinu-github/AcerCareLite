<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AcerCareLite.App</RootNamespace>
    <AssemblyName>AcerCareLite</AssemblyName>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded so XAML and the tray can load it: pack://application:,,,/AppIcon.ico -->
    <Resource Include="AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AcerCareLite.Core\AcerCareLite.Core.csproj" />
    <ProjectReference Include="..\AcerCareLite.Windows\AcerCareLite.Windows.csproj" />
    <ProjectReference Include="..\AcerCareLite.Acer\AcerCareLite.Acer.csproj" />
    <!-- Build-only reference: the elevated read-only helper is built first and copied next to AcerCareLite.exe (see CopyAcerHelper). -->
    <ProjectReference Include="..\AcerCareLite.AcerHelper\AcerCareLite.AcerHelper.csproj" ReferenceOutputAssembly="false" OutputItemType="AcerHelperOutput" />
  </ItemGroup>
  <Target Name="CopyAcerHelper" AfterTargets="Build" Condition="'@(AcerHelperOutput)' != ''">
    <ItemGroup>
      <_AcerHelperFiles Include="%(AcerHelperOutput.RootDir)%(AcerHelperOutput.Directory)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AcerHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- WPF and WinForms both define Application, MessageBox, Point... Keep only the WPF names global. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>