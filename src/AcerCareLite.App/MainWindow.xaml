<Window x:Class="AcerCareLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pres="clr-namespace:AcerCareLite.Core.Presentation;assembly=AcerCareLite.Core"
        xmlns:views="clr-namespace:AcerCareLite.App.Views"
        Title="AcerCareLite" Width="1100" Height="720" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type pres:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:UtilitiesViewModel}">
            <views:UtilitiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="AcerCareLite" FontSize="16" FontWeight="SemiBold"
                           Margin="20,20,20,16" />
                <ListBox Style="{StaticResource NavListBox}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Width="26" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32" />
    </Grid>
</Window>
