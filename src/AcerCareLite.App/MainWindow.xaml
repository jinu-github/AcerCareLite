<Window x:Class="AcerCareLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:pres="clr-namespace:AcerCareLite.Core.Presentation;assembly=AcerCareLite.Core"
        xmlns:views="clr-namespace:AcerCareLite.App.Views"
        xmlns:ctl="clr-namespace:AcerCareLite.App.Controls"
        xmlns:conv="clr-namespace:AcerCareLite.App.Converters"
        Title="AcerCareLite" Width="1100" Height="720" MinWidth="800" MinHeight="520"
        Icon="pack://application:,,,/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <!-- The title bar (top 40 px) is draggable; the buttons inside it opt back in with IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:NavIconConverter x:Key="NavIcon" />

        <DataTemplate DataType="{x:Type pres:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:BatteryViewModel}">
            <views:BatteryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:UtilitiesViewModel}">
            <views:UtilitiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pres:PlaceholderPageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: app icon and name on the left, window buttons on the right. -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <ctl:IconPath Width="15" Height="15" StrokeThickness="1.9"
                                      Data="{DynamicResource Icon.Battery}" Stroke="{DynamicResource AccentBrush}" />
                        <TextBlock Text="AcerCareLite" Margin="10,0,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButtonStyle}"
                                Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                            <ctl:IconPath Width="16" Height="16" StrokeThickness="2"
                                          Data="{DynamicResource Icon.Minimize}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource ChromeButtonStyle}"
                                Click="MaxRestore_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                            <ctl:IconPath x:Name="MaxRestoreIcon" Width="16" Height="16" StrokeThickness="2"
                                          Data="{DynamicResource Icon.Maximize}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource ChromeCloseButtonStyle}"
                                Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                            <ctl:IconPath Width="16" Height="16" StrokeThickness="2"
                                          Data="{DynamicResource Icon.Close}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: a fixed 232 px navigation column. -->
                <Border Grid.Column="0" Width="232"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="76" Margin="16,0,0,6">
                            <ctl:IconPath Width="30" Height="30" StrokeThickness="1.5" VerticalAlignment="Center"
                                          Data="{DynamicResource Icon.Battery}" Stroke="{DynamicResource AccentBrush}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AcerCareLite" FontSize="16" FontWeight="Bold" TextWrapping="NoWrap" />
                                <TextBlock Text="Device management" FontSize="11.5" Margin="0,1,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom block: divider and version. -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Style="{StaticResource RowDivider}" />
                            <TextBlock x:Name="VersionText" Margin="26,12,0,14" FontSize="11" TextWrapping="NoWrap"
                                       FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <ListBox Style="{StaticResource NavListBox}"
                                 ItemsSource="{Binding Pages}"
                                 SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                                        <ctl:IconPath Width="18" Height="18" VerticalAlignment="Center" StrokeThickness="1.5"
                                                      Data="{Binding Glyph, Converter={StaticResource NavIcon}}">
                                            <ctl:IconPath.Style>
                                                <Style TargetType="ctl:IconPath">
                                                    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ctl:IconPath.Style>
                                        </ctl:IconPath>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="32,28,28,0" IsTabStop="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
