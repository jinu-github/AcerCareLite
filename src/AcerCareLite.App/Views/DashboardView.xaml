<UserControl x:Class="AcerCareLite.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
            <WrapPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding CpuValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding GpuValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource CardValue}" FontSize="20" />
                        <ProgressBar Value="{Binding MemoryValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Battery" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding PowerText}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding PowerValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                        <TextBlock Text="{Binding PowerStateText}" Margin="0,8,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Storage" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding StorageNote}" Foreground="{StaticResource SubtleTextBrush}" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,6" />
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding SystemInfoText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
