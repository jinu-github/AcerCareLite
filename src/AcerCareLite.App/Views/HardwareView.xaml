<UserControl x:Class="AcerCareLite.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AcerCareLite.App.Controls"
             xmlns:conv="clr-namespace:AcerCareLite.App.Converters">
    <UserControl.Resources>
        <conv:CountLabelConverter x:Key="CountLabel" />

        <!-- One hardware entry: bold title over a quiet detail line, with a thin line between entries. -->
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="Row" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="13"
                               Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Row" Property="Padding" Value="0,2,0,12" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1560" Margin="0,0,6,28">

            <ctl:PageHeader Title="Hardware" Subtitle="Components as reported by Windows (WMI / CIM)">
                <ctl:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusText}" Margin="0,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:IconPath Width="16" Height="16" StrokeThickness="1.9"
                                              Data="{DynamicResource Icon.Refresh}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Refresh" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ctl:PageHeader.Actions>
            </ctl:PageHeader>

            <Grid x:Name="CardGrid" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColumnA" Width="*" />
                    <ColumnDefinition x:Name="Gap" Width="16" />
                    <ColumnDefinition x:Name="ColumnB" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CpuCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" Padding="22,20,22,10" Margin="0,0,0,16">
                    <StackPanel>
                        <ctl:SectionHeader Title="PROCESSOR" Icon="{DynamicResource Icon.Cpu}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Cpu}" AlternationCount="1000" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>

                <Border x:Name="GpuCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource Panel}" Padding="22,20,22,10" Margin="0,0,0,16">
                    <StackPanel>
                        <ctl:SectionHeader Title="GRAPHICS" Icon="{DynamicResource Icon.Monitor}"
                                           Aside="{Binding Gpu.Count, Converter={StaticResource CountLabel}, ConverterParameter=adapter}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Gpu}" AlternationCount="1000" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>

                <Border x:Name="MemoryCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Padding="22,20,22,10">
                    <StackPanel>
                        <ctl:SectionHeader Title="MEMORY MODULES" Icon="{DynamicResource Icon.Memory}"
                                           Aside="{Binding Memory.Count, Converter={StaticResource CountLabel}, ConverterParameter=module}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Memory}" AlternationCount="1000" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DiskCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Padding="22,20,22,10">
                    <StackPanel>
                        <ctl:SectionHeader Title="STORAGE DEVICES" Icon="{DynamicResource Icon.Storage}"
                                           Aside="{Binding Disks.Count, Converter={StaticResource CountLabel}, ConverterParameter=physical disk}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Disks}" AlternationCount="1000" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
