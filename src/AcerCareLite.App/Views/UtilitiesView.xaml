<UserControl x:Class="AcerCareLite.App.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AcerCareLite.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Text" Value="Disabled" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Entry.Enabled}" Value="True">
                    <Setter Property="Text" Value="Enabled" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanToggle}" Value="False">
                    <Setter Property="Text" Value="Disabled · needs admin" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Entry.Enabled}" Value="True" />
                        <Condition Binding="{Binding CanToggle}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="Enabled · needs admin" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartupSwitch" TargetType="Button" BasedOn="{StaticResource SwitchButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Entry.Enabled}" Value="True">
                    <Setter Property="Tag" Value="On" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1560" Margin="0,0,6,28">

            <ctl:PageHeader Title="Utilities" Subtitle="Windows maintenance tasks">
                <ctl:PageHeader.Actions>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconPath Width="16" Height="16" StrokeThickness="1.9"
                                          Data="{DynamicResource Icon.Refresh}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Refresh" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </ctl:PageHeader.Actions>
            </ctl:PageHeader>

            <TextBlock Text="{Binding ResultText}" Margin="0,14,0,0" FontSize="14" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <UniformGrid x:Name="CardGrid" Columns="3" Margin="0,22,-16,0">
                <!-- Temporary files -->
                <Border Style="{StaticResource Panel}" Padding="22,20,22,22" Margin="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ctl:SectionHeader Title="TEMPORARY FILES" Icon="{DynamicResource Icon.FileClean}" />
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Text="{Binding TempText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                       Text="Only files older than 24 hours in your own temp folder. Files in use are skipped." />
                        </StackPanel>
                        <Button Grid.Row="3" Content="Clean" Command="{Binding CleanTempCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" MinWidth="86" Margin="0,18,0,0" />
                    </Grid>
                </Border>

                <!-- Recycle Bin -->
                <Border Style="{StaticResource Panel}" Padding="22,20,22,22" Margin="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ctl:SectionHeader Title="RECYCLE BIN" Icon="{DynamicResource Icon.Trash}" />
                        <TextBlock Grid.Row="1" Text="{Binding RecycleText}" Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button Grid.Row="3" Content="Empty" Command="{Binding EmptyRecycleCommand}" Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left" MinWidth="86" Margin="0,18,0,0" />
                    </Grid>
                </Border>

                <!-- Storage overview -->
                <Border Style="{StaticResource Panel}" Padding="22,20,22,12" Margin="0,0,16,16">
                    <StackPanel>
                        <ctl:SectionHeader Title="STORAGE OVERVIEW" Icon="{DynamicResource Icon.Storage}" Aside="{Binding ReclaimText}" />
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" TextAlignment="Right" TextWrapping="Wrap"
                                                   HorizontalAlignment="Right" Margin="10,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                                     Style="{StaticResource SlimProgress}" Value="{Binding UsedPercent, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Startup apps -->
            <Border Style="{StaticResource Panel}" Padding="22,20,22,8">
                <StackPanel>
                    <ctl:SectionHeader Title="STARTUP APPS" Icon="{DynamicResource Icon.Rocket}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,12,0,8"
                               Text="Disabling only turns the entry off, like Task Manager. Nothing is deleted. Entries for all users need administrator rights." />
                    <ItemsControl ItemsSource="{Binding StartupRows}" AlternationCount="1000" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StartupSource" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="StartupStatus" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Command}" Margin="0,2,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubtleTextBrush}" ToolTip="{Binding Command}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Entry.SourceText}" VerticalAlignment="Center" TextAlignment="Right"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="16,0,0,0" MaxWidth="170"
                                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource StatusText}" VerticalAlignment="Center"
                                                   TextAlignment="Right" TextWrapping="Wrap" Margin="16,0,14,0" MaxWidth="150" />
                                        <Button Grid.Column="3" Style="{StaticResource StartupSwitch}" VerticalAlignment="Center"
                                                IsEnabled="{Binding CanToggle}" ToolTip="{Binding ButtonText}"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
