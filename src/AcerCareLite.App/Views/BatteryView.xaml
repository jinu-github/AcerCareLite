<UserControl x:Class="AcerCareLite.App.Views.BatteryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AcerCareLite.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Battery" FontSize="28" FontWeight="SemiBold" />
            <WrapPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Charge" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding PercentValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                        <TextBlock Text="{Binding StateText}" Margin="0,8,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Health (full charge vs design)" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding HealthValue, Mode=OneWay}" Style="{StaticResource ThinProgress}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Capacity" Style="{StaticResource CardTitle}" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Design  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding DesignText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="Full charge  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding FullText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="Now  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding RemainingText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource CardTitle}" />
                        <TextBlock Margin="0,8,0,0"><Run Text="Voltage  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding VoltageText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0"><Run Text="Rate  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding RateText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Cycles  " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding CycleText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Border HorizontalAlignment="Stretch" Width="NaN" MaxWidth="1040">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Acer}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel DataContext="{Binding Acer}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ButtonText}" Command="{Binding CheckCommand}"
                                Style="{StaticResource ActionButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Text="Acer battery health mode (about 80 % charge limit)" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CheckedAtText}" Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="{Binding InstallText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWriteAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="{Binding SetButtonText}" Command="{Binding SetCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding WriteStatusText}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding WriteDetailText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding WriteEvidenceText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FooterText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="NaN" HorizontalAlignment="Stretch" MaxWidth="1040">
                <StackPanel>
                    <TextBlock Text="Last 24 hours" Style="{StaticResource CardTitle}" />
                    <ctl:BatteryChart Samples="{Binding History}" Height="220" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
